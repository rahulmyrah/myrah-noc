# ─────────────────────────────────────────────────────────────────────────────
# Myrah NOC Platform — Environment Variables
# Copy this file to .env and fill in real values before running docker compose
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Service Principal ───────────────────────────────────────────────────
# Create with: az ad sp create-for-rbac --name "myrah-noc-reader" \
#   --role "Monitoring Reader" --scopes /subscriptions/{SUBSCRIPTION_ID}
# Then add: az role assignment create --assignee {APP_ID} \
#   --role "Cost Management Reader" --scope /subscriptions/{SUBSCRIPTION_ID}
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-value
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Uptime Kuma ───────────────────────────────────────────────────────────────
# Admin password for Uptime Kuma (set on first login at http://localhost:3001)
UPTIME_KUMA_ADMIN_PASSWORD=MyrahNOC2026!

# ── Healthchecks ─────────────────────────────────────────────────────────────
# Secret key for the Healthchecks self-hosted instance
HEALTHCHECKS_SECRET_KEY=myrah-hc-secret-2026
# API key — create at http://localhost:8000/integrations/add/api/ after startup
HEALTHCHECKS_API_KEY=your-healthchecks-api-key

# ── MS Teams Alerts ───────────────────────────────────────────────────────────
# Teams > Channel > Connectors > Incoming Webhook > Create
# Leave blank to disable Teams notifications
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxxx/IncomingWebhook/xxxx

# ── Grafana ───────────────────────────────────────────────────────────────────
# Admin password for Grafana at http://localhost:3003
GRAFANA_ADMIN_PASSWORD=MyrahNOC2026!

# ── VPS Deployment ───────────────────────────────────────────────────────────
# Your VPS domain or IP — used by Nginx Proxy Manager, Grafana, Healthchecks
# Local dev: leave as localhost
# VPS: set to your domain e.g. noc.myrah.io
VPS_DOMAIN=localhost

# ── Client Branding ──────────────────────────────────────────────────────────
CLIENT_NAME=Demo Client Ltd

# ── AI Assistant ──────────────────────────────────────────────────────────────
# OpenAI API key for the hub AI assistant (gpt-4o-mini)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
